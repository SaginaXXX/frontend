# AI广告屏系统 - 前端Dockerfile (生产环境)
FROM node:18-alpine AS builder

WORKDIR /app

# 复制package文件
COPY package*.json ./

# 安装依赖
RUN npm ci

# 复制源代码
COPY . .

# 构建生产版本（web模式，输出到 dist/web）
RUN npm run build:web

# ===== 生产镜像 =====
FROM nginx:alpine

# 复制构建产物（复制web目录的内容到nginx根目录）
COPY --from=builder /app/dist/web/. /usr/share/nginx/html/

# 复制Nginx配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 3000

# 启动Nginx
CMD ["nginx", "-g", "daemon off;"]

